# ==============================================================================
# ChasquiFly Backend - Environment Variables Template
# Copy this file to .env or configure these variables in your IDE / Render.com
# ==============================================================================

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Supabase PostgreSQL Database Configuration
# Direct Connection or Connection Pooler (Transaction / Session)
# Example: jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://<SUPABASE_HOST>:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=dM5ZeFUXGCpZ4esm

# Flyway Database Migration
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true

# JWT Security Configuration
# Secret key must be a base64 or minimum 256-bit string (32+ chars)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://chasquifly.vercel.app,https://chasquifly.onrender.com

# Duffel API Integration (Optional / Sandbox)
DUFFEL_API_TOKEN=duffel_test_xxxxxxxxxxxxxxxxxxxxxxxxxx
DUFFEL_BASE_URL=https://api.duffel.com
DUFFEL_ENABLED=false
